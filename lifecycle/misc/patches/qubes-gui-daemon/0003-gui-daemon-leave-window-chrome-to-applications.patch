From 4840904332466b6c9d34e4626e1bbb6ea26c5d33 Mon Sep 17 00:00:00 2001
From: Airlock Developers <airlock@example.invalid>
Date: Thu, 1 Oct 2026 15:12:21 +0100
Subject: [PATCH] gui-daemon: leave window chrome to applications in GNOME

---
 gui-daemon/xside.c | 22 ++++++++--------------
 1 file changed, 8 insertions(+), 14 deletions(-)

diff --git a/gui-daemon/xside.c b/gui-daemon/xside.c
index a39d41d..784bab5 100644
--- a/gui-daemon/xside.c
+++ b/gui-daemon/xside.c
@@ -382,6 +382,13 @@ static Window mkwindow(Ghandles * g, struct windowdata *vm_window)
     (void) XSetStandardProperties(g->display, child_win,
                       "VMapp command", "Pixmap", None,
                       gargv, 0, &my_size_hints);
+    /* Airlock's GNOME session uses its trusted panel for VM identity.
+     * Applications own their chrome; apply the same policy to every window
+     * before the window manager sees it, without changing managed state. */
+    const Atom motif_hints = XInternAtom(g->display, "_MOTIF_WM_HINTS", False);
+    const unsigned long no_decorations[5] = { 2, 0, 0, 0, 0 };
+    XChangeProperty(g->display, child_win, motif_hints, motif_hints, 32,
+            PropModeReplace, (const unsigned char *)no_decorations, 5);
     if (g->time_win != None)
         XChangeProperty(g->display, child_win, g->wm_user_time_window,
                XA_WINDOW, 32, PropModeReplace,
@@ -2252,7 +2259,7 @@ static void do_shm_update(Ghandles * g, struct windowdata *vm_window,
            int untrusted_x, int untrusted_y, int untrusted_w,
            int untrusted_h)
 {
-    int border_width = BORDER_WIDTH;
+    int border_width = 0; /* VM identity is displayed by the GNOME panel. */
     int border_padding = 0; /* start forced border x pixels from the edge */
     int x = 0, y = 0, w = 0, h = 0;
     ASSERT_WIDTH_UNSIGNED(vm_window->width);
@@ -2369,19 +2376,6 @@ static void do_shm_update(Ghandles * g, struct windowdata *vm_window,
 
     /* sanitize end */
 
-    if (!vm_window->override_redirect) {
-        // Window Manager will take care of the frame...
-        border_width = 0;
-    }
-
-    if (vm_window->is_docked) {
-        if (g->trayicon_border) {
-            border_width = 1;
-            border_padding = g->trayicon_border - 1;
-        } else
-            border_width = 0;
-    }
-
     assert(x >= 0 && y >= 0 && w >= 0 && h >= 0);
     assert(border_width >= 0);
 
-- 
2.54.0

